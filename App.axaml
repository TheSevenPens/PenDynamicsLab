<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PenDynamicsLab.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- The whole palette, light and dark, lives in Theming/Palette.axaml. It also carries
         the Button* overrides that retone Fluent's mid-grey button fill to a white surface
         with a 1px edge; those are theme-scoped now, so the dark column retones them again
         rather than leaving light-mode greys on a dark window.

         RequestedThemeVariant is a starting value only. MainWindow's constructor replaces it
         with the saved preference before building its tree, and ThemeService owns it after. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PenDynamicsLab/Theming/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
