<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PenDynamicsLab.Controls"
        x:Class="PenDynamicsLab.MainWindow"
        Title="PenDynamicsLab" Width="1650" Height="900"
        Background="{DynamicResource Pdl.Pane}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Styles>
        <!-- One vocabulary. Hierarchy comes from colour and size, never from caps or
             bold; every interactive control is 32px tall with a 4px radius. -->
        <Style Selector="TextBlock">    <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="TextBox">      <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="4" /></Style>
        <Style Selector="Button">       <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="4" /></Style>
        <Style Selector="ComboBox">     <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="4" /></Style>
        <Style Selector="ComboBoxItem"> <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="CheckBox">     <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="RadioButton">  <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="MenuItem">     <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="Slider">       <Setter Property="FontSize" Value="13" /></Style>
        <!-- MinHeight as well as FontSize. The Fluent default is 48, which centres a 14pt label
             and pins the selected-tab indicator to the bottom - leaving about 15 DIPs of empty
             space between the two, so the underline read as belonging to nothing in particular.
             38 closes most of that without crowding the label. -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="38" />
        </Style>

        <!-- A muted label sitting beside its control. Replaces the bold uppercase
             micro-labels that were the app's strongest dated signal.

             Same FontSize as .readout on purpose. These two sit in label/value pairs in the
             telemetry grids, and a Grid aligns boxes rather than baselines - so a smaller label
             left the value's text sitting lower than its own, by 3 physical pixels at 2.25x
             scaling. Matching the size makes the line boxes match, which aligns the baselines by
             construction rather than by a hand-tuned margin that would drift at another DPI.

             The hierarchy is carried by colour instead, which was always doing most of the work:
             Pdl.Muted here against Pdl.Text on the value. It also puts these in step with the
             ComboBox / Slider / CheckBox they label, which are all 13. -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Pdl.Muted}" />
        </Style>
        <!-- Caption over a telemetry group. Same FontSize as everything else in the ribbon:
             the recession is carried by colour, which already runs three steps deep -
             Pdl.Text on values, Pdl.Muted on field labels, Pdl.GroupLabel lightest of all on
             these. A smaller size added nothing the colour was not already doing, and left
             the captions looking slightly undersized rather than deliberately quiet.

             The other option was a small-caps "eyebrow" caption, but that wants uppercase and
             letterspacing to look intentional, and this app deliberately moved away from bold
             uppercase micro-labels - see .fieldLabel. -->
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Pdl.GroupLabel}" />
        </Style>
        <!-- Live numeric value. -->
        <Style Selector="TextBlock.readout">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Pdl.Text}" />
        </Style>
        <!-- Reserves the width of the widest value a readout column can ever hold, so the
             telemetry groups keep fixed widths and positions while the numbers change.
             Opacity rather than IsVisible: IsVisible="False" collapses it out of layout,
             which is the one thing this must not do. Sized in glyphs rather than pixels so
             it stays correct if the font or DPI changes. -->
        <Style Selector="TextBlock.sizer">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Slider:horizontal /template/ Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <!-- Telemetry ribbon. The driver tip lives at its right-hand end, in space that
             was running empty, so the advice costs no vertical band. -->
        <!-- Vertical padding matters as much as horizontal here: the inner DockPanel has a fixed
             height and the tallest group (Position, four rows) filled it, leaving the Canvas row's
             text three physical pixels off the divider. Padding on the Border moves the divider
             rather than squeezing the content, so the groups keep the box they were laid out in. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel x:Name="RibbonPanel" Height="92">

                <!-- Gear first, so it takes the OUTERMOST right slot: DockPanel fills in
                     child order, and the tip chip beside it is dismissible. Declared the
                     other way round, the gear would slide sideways the moment the tip
                     went away. 32x32 with a 4px radius, the same glyph button the curve
                     and smoothing resets use. -->
                <Button DockPanel.Dock="Right" x:Name="OptionsButton"
                        Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="15" Width="32" Height="32" Padding="0"
                        Margin="16,0,0,0" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Options" Click="Options_Click" />

                <!-- Collapse toggle. Inside the gear rather than outside it: the gear is the
                     fixed landmark at the edge, and a control that changes the ribbon's
                     height should not also be the thing that moves when it does. -->
                <Button DockPanel.Dock="Right" x:Name="RibbonToggle"
                        Content="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="11" Width="32" Height="32" Padding="0"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip.Tip="Collapse the telemetry ribbon"
                        Click="RibbonToggle_Click" />

                <Border DockPanel.Dock="Right" x:Name="DriverTipChip"
                        Background="{DynamicResource Pdl.AdvisoryFill}" BorderBrush="{DynamicResource Pdl.AdvisoryEdge}" BorderThickness="1"
                        CornerRadius="14" Height="28" Padding="10,0,4,0"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="DriverTipButton" Background="Transparent" BorderThickness="0"
                                Padding="0" Cursor="Hand" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12" Foreground="{DynamicResource Pdl.AdvisoryIcon}" VerticalAlignment="Center" />
                                <TextBlock Text="Set driver curve to linear" FontSize="12"
                                           Foreground="{DynamicResource Pdl.AdvisoryInk}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="320" Spacing="14">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Pdl.Text}"
                                                   Text="Set your tablet driver's pressure curve to default (linear) so this app sees raw pen input — otherwise you're tuning a curve on top of a curve." />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="Don't show again" Height="30" Padding="12,0"
                                                    VerticalContentAlignment="Center"
                                                    Click="DriverTipNeverShow_Click" />
                                            <Button Content="Got it" Height="30" Padding="14,0" Classes="accent"
                                                    VerticalContentAlignment="Center"
                                                    Click="DriverTipGotIt_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="DriverTipDismiss" Content="&#xE711;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                Foreground="{DynamicResource Pdl.AdvisoryIcon}" Background="Transparent" BorderThickness="0"
                                Width="20" Height="20" Padding="0" VerticalAlignment="Center"
                                ToolTip.Tip="Hide for this session"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="DriverTipDismiss_Click" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="RibbonBody" Orientation="Horizontal" Spacing="36" VerticalAlignment="Center">

                    <StackPanel Spacing="6">
                        <TextBlock Text="Pen API" Classes="groupLabel" />
                        <ComboBox x:Name="ApiCombo" Width="150" Height="32" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Pen" Classes="groupLabel" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="ProximityDot" Width="7" Height="7" Fill="{DynamicResource Pdl.ProximityIdle}"
                                     VerticalAlignment="Center" />
                            <!-- "Out of range" is the wider of the two states it toggles between. -->
                            <Grid>
                                <TextBlock Classes="sizer" Text="Out of range" />
                                <TextBlock x:Name="ProximityLabel" Text="Out of range" Classes="readout"
                                           Foreground="{DynamicResource Pdl.Muted}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="CursorLabel" Text="--" Classes="readout" Foreground="{DynamicResource Pdl.Muted}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Position" Classes="groupLabel" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                              >
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="sizer" Text="888888, 888888" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Raw" Classes="fieldLabel" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RawPosLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen" Classes="fieldLabel" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ScreenPosLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="App" Classes="fieldLabel" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AppPosLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Canvas" Classes="fieldLabel" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CanvasPosLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Pressure" Classes="groupLabel" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                              >
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="sizer" Text="888888" FontWeight="SemiBold" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Raw" Classes="fieldLabel" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RawPressureLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Normalized" Classes="fieldLabel" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NormPressureLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Processed" Classes="fieldLabel" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProcessedPressureLabel" Text="--" Margin="12,0,0,0"
                                       Classes="readout" Foreground="{DynamicResource Pdl.Processed}" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Orientation" Classes="groupLabel" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                              >
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="sizer" Text="-888.8&#xB0;" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Azimuth" Classes="fieldLabel" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AzimuthLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Altitude" Classes="fieldLabel" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AltitudeLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Twist" Classes="fieldLabel" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TwistLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>


        <!-- Body: left = curve chart + control cards, right = drawing canvases -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="472" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LeftPanel: settings first, then the curve — so the row reads
                 configure → mapping → stroke, and the curve sits directly against the
                 canvas it drives rather than across the pane from it. Both columns are
                 equal-width by construction (two * columns). -->
            <Grid x:Name="LeftPanel" Grid.Column="0" Background="{DynamicResource Pdl.Pane}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Column 1: the settings cards. Presets is pinned to the bottom row so
                     the slack falls between groups instead of trailing off the end. -->
                <Grid Grid.Column="0" Margin="14,12,7,12" RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <!-- Card order follows the processing order, so the column reads in
                             pipeline order rather than needing a pill to describe it.
                             Reordered in code by ApplyCardOrder. -->
                        <StackPanel x:Name="SettingsStack">

                        <!-- First in the pipeline, and fixed there: quantization models the
                             resolution the pressure arrived at, so nothing downstream can
                             undo it. No reset button — the level IS the only setting, so
                             there would be nothing for reset to restore. -->
                        <controls:SectionCard x:Name="QuantizationCard" Title="Quantization">
                            <controls:SectionCard.CardContent>
                                <ComboBox x:Name="QuantizationCombo" Height="32" HorizontalAlignment="Stretch" />
                            </controls:SectionCard.CardContent>
                        </controls:SectionCard>

                        <!-- Curve 1 shapes the pen's pressure; curve 2 shapes what curve 1
                             produced. The numbering is the order, and the effective chart
                             below shows the pair collapsed into one mapping. -->
                        <controls:SectionCard x:Name="Curve1Card" Title="Curve 1">
                            <controls:SectionCard.CardContent>
                                <controls:CurveEditorView x:Name="Curve1Editor" />
                            </controls:SectionCard.CardContent>
                        </controls:SectionCard>

                        <controls:SectionCard x:Name="Curve2Card" Title="Curve 2">
                            <controls:SectionCard.CardContent>
                                <controls:CurveEditorView x:Name="Curve2Editor" />
                            </controls:SectionCard.CardContent>
                        </controls:SectionCard>

                        <controls:SectionCard x:Name="SmoothingCard" Title="Smoothing">
                            <controls:SectionCard.CardContent>
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <Button x:Name="SmoothingResetButton" DockPanel.Dock="Right"
                                            Content="&#x21BB;" Width="32" Height="32" Padding="0"
                                            Margin="6,0,0,0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="Reset the smoothing amount to its default"
                                            Click="SmoothingReset_Click" />
                                    <ComboBox x:Name="SmoothingTypeCombo" Height="32" HorizontalAlignment="Stretch" />
                                </DockPanel>
                                <controls:LabeledSlider x:Name="PressureEmaSlider" Label="Smoothing Amount"
                                                        Minimum="0" Maximum="0.99" Value="0" DefaultValue="0" />
                            </StackPanel>
                            </controls:SectionCard.CardContent>
                        </controls:SectionCard>

                        </StackPanel>
                    </ScrollViewer>

                    <controls:SectionCard Grid.Row="1" x:Name="PresetsCard" Title="Presets" Margin="0,8,0,0">
                        <controls:SectionCard.CardContent>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PresetEmptyLabel" Text="No saved presets yet"
                                           FontSize="12" Foreground="{DynamicResource Pdl.GroupLabel}" />
                                <StackPanel x:Name="PresetList" Spacing="2" />
                                <!-- Only shown for a rename; saving generates a name and needs no prompt. -->
                                <StackPanel x:Name="PresetNameRow" Spacing="4" IsVisible="False">
                                    <TextBox x:Name="PresetNameInput" Height="32" Watermark="Preset name..."
                                             TextChanged="PresetNameInput_TextChanged" />
                                    <!-- Says why a rename did not happen. Hidden until one does not. -->
                                    <TextBlock x:Name="PresetNameMessage" IsVisible="False"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Pdl.AdvisoryInk}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button x:Name="PresetCancelButton" Content="Cancel"
                                                Click="PresetCancel_Click" />
                                        <Button x:Name="PresetConfirmButton" Content="Save"
                                                Click="PresetConfirm_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="PresetSaveButton" Content="Save current settings"
                                        Height="32" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Click="PresetSave_Click" />
                            </StackPanel>
                        </controls:SectionCard.CardContent>
                    </controls:SectionCard>
                </Grid>

                <!-- Column 2: the curves, sitting against the canvas they drive.

                     The plot is square and sized off its width, so a chart's HEIGHT follows
                     its width and the only way to shorten these cards is to cap that width.
                     MaxWidth 170 buys ~25px per card — 75px across the three — at the cost
                     of a little space either side of each plot. The alternative, narrowing
                     the chart column, would break the equal columns these were built to. -->
                <StackPanel Grid.Column="1" Margin="7,12,14,12" Spacing="6">
                    <Border x:Name="Chart1Card" Background="{DynamicResource Pdl.Surface}" BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1"
                            CornerRadius="8" Padding="10,7,10,8">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="Chart1Title" Text="Pressure curve 1" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Pdl.Text}" />
                            <controls:PressureChartControl x:Name="PressureChart" MaxWidth="170" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="Chart2Card" Background="{DynamicResource Pdl.Surface}" BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1"
                            CornerRadius="8" Padding="10,7,10,8">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Pressure curve 2" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Pdl.Text}" />
                            <controls:PressureChartControl x:Name="PressureChart2" MaxWidth="170" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Derived, not edited: accent border and trace, no draggable nodes. -->
                    <Border x:Name="EffectiveCard" Background="{DynamicResource Pdl.Surface}" BorderBrush="{DynamicResource Pdl.Accent}" BorderThickness="1"
                            CornerRadius="8" Padding="10,7,10,8">
                        <StackPanel Spacing="5">
                            <DockPanel>
                                <Border x:Name="EffectivePill" DockPanel.Dock="Right"
                                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="EffectivePillText" FontSize="11" />
                                </Border>
                                <TextBlock Text="Effective pressure curve" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Pdl.Text}" VerticalAlignment="Center" />
                            </DockPanel>
                            <controls:EffectiveCurveChartControl x:Name="EffectiveChart" MaxWidth="170" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Transient feedback only ("Copied"); empty the rest of the time, so
                         the row collapses to nothing. -->
                    <TextBlock x:Name="ChartStatusLabel" Margin="0,8,0,0" FontSize="12"
                               Foreground="{DynamicResource Pdl.Processed}" />
                </StackPanel>
            </Grid>

            <!-- Splitter -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource Pdl.Divider}" />

            <!-- Right panel: tabbed views. Each tab is its own workflow. -->
            <DockPanel x:Name="CanvasArea" Grid.Column="2" Background="{DynamicResource Pdl.Surface}">
                <TabControl x:Name="RightTabs" Padding="0">
                    <TabItem x:Name="StrokeTab" Header="Stroke">
                        <DockPanel>
                            <ContentControl x:Name="StrokeBrushSlot" DockPanel.Dock="Top" />
                            <controls:StrokeCanvasView x:Name="StrokeView" Header="Use processed pressure data" />
                        </DockPanel>
                    </TabItem>

                    <TabItem x:Name="StrokeCompareTab" Header="Stroke compare">
                        <DockPanel>
                            <ContentControl x:Name="CompareBrushSlot" DockPanel.Dock="Top" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <controls:StrokeCanvasView Grid.Row="0" x:Name="CompareProcessedView"
                                                           Header="Use processed pressure data" />
                                <Rectangle Grid.Row="1" Fill="{DynamicResource Pdl.Splitter}" />
                                <controls:StrokeCanvasView Grid.Row="2" x:Name="CompareRawView"
                                                           Header="Use raw pressure data" />
                            </Grid>
                        </DockPanel>
                    </TabItem>

                <TabItem Header="Pressure response">
                    <DockPanel Margin="12">
                        <StackPanel DockPanel.Dock="Top" Spacing="8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="ResponseClearButton" Content="Clear"
                                        IsEnabled="False" Margin="6,0,0,0" Click="ResponseClear_Click" />
                                <ComboBox x:Name="ResponseDataCombo" HorizontalAlignment="Stretch"
                                          PlaceholderText="Select data..." />
                            </DockPanel>
                            <CheckBox x:Name="ResponseShowCurveEffectCheck" Content="Show effect of curve"
                                      IsChecked="True" />
                            <TextBlock x:Name="ResponseInfoLabel" Foreground="{DynamicResource Pdl.Hint}" />
                        </StackPanel>
                        <controls:PressureResponseChartControl x:Name="ResponseChart" />
                    </DockPanel>
                </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
