<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PenDynamicsLab.Controls"
        x:Class="PenDynamicsLab.MainWindow"
        Title="PenDynamicsLab" Width="1650" Height="900"
        Background="#F9F9F9"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Window.Styles>
        <!-- One vocabulary. Hierarchy comes from colour and size, never from caps or
             bold; every interactive control is 32px tall with a 4px radius. -->
        <Style Selector="TextBlock">    <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="TextBox">      <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="4" /></Style>
        <Style Selector="Button">       <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="4" /></Style>
        <Style Selector="ComboBox">     <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="4" /></Style>
        <Style Selector="ComboBoxItem"> <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="CheckBox">     <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="RadioButton">  <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="MenuItem">     <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="Slider">       <Setter Property="FontSize" Value="13" /></Style>
        <Style Selector="TabItem">      <Setter Property="FontSize" Value="14" /></Style>

        <!-- A muted label sitting beside its control. Replaces the bold uppercase
             micro-labels that were the app's strongest dated signal. -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#616161" />
        </Style>
        <!-- Caption over a telemetry group. -->
        <Style Selector="TextBlock.groupLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#909090" />
        </Style>
        <!-- Live numeric value. -->
        <Style Selector="TextBlock.readout">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#242424" />
        </Style>
        <!-- Reserves the width of the widest value a readout column can ever hold, so the
             telemetry groups keep fixed widths and positions while the numbers change.
             Opacity rather than IsVisible: IsVisible="False" collapses it out of layout,
             which is the one thing this must not do. Sized in glyphs rather than pixels so
             it stays correct if the font or DPI changes. -->
        <Style Selector="TextBlock.sizer">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Slider:horizontal /template/ Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <!-- Telemetry ribbon. The driver tip lives at its right-hand end, in space that
             was running empty, so the advice costs no vertical band. -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF"
                BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel Height="92">

                <Border DockPanel.Dock="Right" x:Name="DriverTipChip"
                        Background="#FFF9F0" BorderBrush="#F0D8A8" BorderThickness="1"
                        CornerRadius="14" Height="28" Padding="10,0,4,0"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="DriverTipButton" Background="Transparent" BorderThickness="0"
                                Padding="0" Cursor="Hand" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12" Foreground="#8A6516" VerticalAlignment="Center" />
                                <TextBlock Text="Set driver curve to linear" FontSize="12"
                                           Foreground="#7A5A16" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="320" Spacing="14">
                                        <TextBlock TextWrapping="Wrap" Foreground="#242424"
                                                   Text="Set your tablet driver's pressure curve to default (linear) so this app sees raw pen input — otherwise you're tuning a curve on top of a curve." />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="Don't show again" Height="30" Padding="12,0"
                                                    VerticalContentAlignment="Center"
                                                    Click="DriverTipNeverShow_Click" />
                                            <Button Content="Got it" Height="30" Padding="14,0" Classes="accent"
                                                    VerticalContentAlignment="Center"
                                                    Click="DriverTipGotIt_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="DriverTipDismiss" Content="&#xE711;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                Foreground="#8A6516" Background="Transparent" BorderThickness="0"
                                Width="20" Height="20" Padding="0" VerticalAlignment="Center"
                                ToolTip.Tip="Hide for this session"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="DriverTipDismiss_Click" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="36" VerticalAlignment="Center">

                    <StackPanel Spacing="6">
                        <TextBlock Text="Pen API" Classes="groupLabel" />
                        <ComboBox x:Name="ApiCombo" Width="150" Height="32" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Pen" Classes="groupLabel" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="ProximityDot" Width="7" Height="7" Fill="#B0B0B0"
                                     VerticalAlignment="Center" />
                            <!-- "Out of range" is the wider of the two states it toggles between. -->
                            <Grid>
                                <TextBlock Classes="sizer" Text="Out of range" />
                                <TextBlock x:Name="ProximityLabel" Text="Out of range" Classes="readout"
                                           Foreground="#616161" />
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="CursorLabel" Text="--" Classes="readout" Foreground="#616161" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Position" Classes="groupLabel" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                              >
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="sizer" Text="888888, 888888" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Raw" Classes="fieldLabel" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RawPosLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen" Classes="fieldLabel" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ScreenPosLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="App" Classes="fieldLabel" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AppPosLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Canvas" Classes="fieldLabel" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CanvasPosLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Pressure" Classes="groupLabel" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                              >
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="sizer" Text="888888" FontWeight="SemiBold" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Raw" Classes="fieldLabel" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RawPressureLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Normalized" Classes="fieldLabel" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NormPressureLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Processed" Classes="fieldLabel" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ProcessedPressureLabel" Text="--" Margin="12,0,0,0"
                                       Classes="readout" Foreground="#14A050" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Orientation" Classes="groupLabel" />
                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto"
                              >
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="sizer" Text="-888.8&#xB0;" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Azimuth" Classes="fieldLabel" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AzimuthLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Altitude" Classes="fieldLabel" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AltitudeLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Twist" Classes="fieldLabel" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TwistLabel" Text="--" Classes="readout" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>


        <!-- Body: left = curve chart + control cards, right = drawing canvases -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="472" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LeftPanel: settings first, then the curve — so the row reads
                 configure → mapping → stroke, and the curve sits directly against the
                 canvas it drives rather than across the pane from it. Both columns are
                 equal-width by construction (two * columns). -->
            <Grid x:Name="LeftPanel" Grid.Column="0" Background="#F9F9F9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Column 1: the settings cards. Presets is pinned to the bottom row so
                     the slack falls between groups instead of trailing off the end. -->
                <Grid Grid.Column="0" Margin="14,12,7,12" RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                        <controls:SectionCard x:Name="CurveCard" Title="Curve">
                            <controls:SectionCard.CardContent>
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <Button x:Name="CurveResetButton" DockPanel.Dock="Right"
                                            Content="&#x21BB;" Width="32" Height="32" Padding="0"
                                            Margin="6,0,0,0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="Reset this curve's settings to their defaults"
                                            Click="CurveReset_Click" />
                                    <ComboBox x:Name="CurveTypeCombo" Height="32" HorizontalAlignment="Stretch" />
                                </DockPanel>

                                <!-- Bezier toolbar (visible only for the Bezier curve type) -->
                                <StackPanel x:Name="BezierToolbar" Spacing="4" IsVisible="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="BezierAddButton" Content="Add point" Click="BezierAdd_Click" />
                                        <Button x:Name="BezierRemoveButton" Content="Remove point" Click="BezierRemove_Click" />
                                        <TextBlock x:Name="BezierCountLabel" VerticalAlignment="Center"
                                                   Foreground="#666666" />
                                    </StackPanel>
                                    <TextBlock Text="Right-click in plot to add or remove."
                                               Foreground="#888888" TextWrapping="Wrap" />
                                    <ComboBox x:Name="BezierPresetCombo" HorizontalAlignment="Stretch"
                                              PlaceholderText="Choose preset..." />
                                </StackPanel>

                                <controls:LabeledSlider x:Name="SoftnessSlider" Label="Curve Amount"
                                                        Minimum="-0.9" Maximum="0.9" Value="0" DefaultValue="0" />
                                <controls:LabeledSlider x:Name="InputMinSlider" Label="Input min"
                                                        Minimum="0" Maximum="1" Value="0" DefaultValue="0" />
                                <controls:LabeledSlider x:Name="InputMaxSlider" Label="Input max"
                                                        Minimum="0" Maximum="1" Value="1" DefaultValue="1" />
                                <controls:LabeledSlider x:Name="OutputMinSlider" Label="Output min"
                                                        Minimum="0" Maximum="1" Value="0" DefaultValue="0" />
                                <controls:LabeledSlider x:Name="OutputMaxSlider" Label="Output max"
                                                        Minimum="0" Maximum="1" Value="1" DefaultValue="1" />

                                <StackPanel x:Name="MinApproachPanel" Spacing="4">
                                    <TextBlock Text="Min approach" Foreground="#333333" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <RadioButton x:Name="MinApproachClampRadio" GroupName="MinApproach"
                                                     Content="Clamp" IsChecked="True" />
                                        <RadioButton x:Name="MinApproachCutRadio" GroupName="MinApproach"
                                                     Content="Cut" />
                                    </StackPanel>
                                </StackPanel>

                                <controls:LabeledSlider x:Name="FlatLevelSlider" Label="Flat level"
                                                        Minimum="0" Maximum="1" Value="0.5" DefaultValue="0.5" />
                            </StackPanel>
                            </controls:SectionCard.CardContent>
                        </controls:SectionCard>

                        <controls:SectionCard x:Name="SmoothingCard" Title="Smoothing">
                            <controls:SectionCard.CardContent>
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <Button x:Name="SmoothingResetButton" DockPanel.Dock="Right"
                                            Content="&#x21BB;" Width="32" Height="32" Padding="0"
                                            Margin="6,0,0,0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="Reset the smoothing amount to its default"
                                            Click="SmoothingReset_Click" />
                                    <ComboBox x:Name="SmoothingTypeCombo" Height="32" HorizontalAlignment="Stretch" />
                                </DockPanel>
                                <controls:LabeledSlider x:Name="PressureEmaSlider" Label="Smoothing Amount"
                                                        Minimum="0" Maximum="0.99" Value="0" DefaultValue="0" />
                            </StackPanel>
                            </controls:SectionCard.CardContent>
                        </controls:SectionCard>

                        <controls:SectionCard x:Name="ProcessingOrderCard" Title="Processing">
                            <controls:SectionCard.CardContent>
                            <ComboBox x:Name="ProcessingOrderCombo" Height="32" HorizontalAlignment="Stretch" />
                            </controls:SectionCard.CardContent>
                        </controls:SectionCard>

                        </StackPanel>
                    </ScrollViewer>

                    <controls:SectionCard Grid.Row="1" x:Name="PresetsCard" Title="Presets" Margin="0,8,0,0">
                        <controls:SectionCard.CardContent>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PresetEmptyLabel" Text="No saved presets yet"
                                           FontSize="12" Foreground="#909090" />
                                <StackPanel x:Name="PresetList" Spacing="2" />
                                <!-- Only shown for a rename; saving generates a name and needs no prompt. -->
                                <StackPanel x:Name="PresetNameRow" Spacing="4" IsVisible="False">
                                    <TextBox x:Name="PresetNameInput" Height="32" Watermark="Preset name..." />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button x:Name="PresetCancelButton" Content="Cancel"
                                                Click="PresetCancel_Click" />
                                        <Button x:Name="PresetConfirmButton" Content="Save"
                                                Click="PresetConfirm_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="PresetSaveButton" Content="Save current settings"
                                        Height="32" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Click="PresetSave_Click" />
                            </StackPanel>
                        </controls:SectionCard.CardContent>
                    </controls:SectionCard>
                </Grid>

                <!-- Column 2: the curve, sitting against the canvas it drives. -->
                <StackPanel Grid.Column="1" Margin="7,12,14,12">
                    <Border Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="1"
                            CornerRadius="8" Padding="12,10,12,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Pressure curve" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#242424" />
                            <controls:PressureChartControl x:Name="PressureChart" />
                        </StackPanel>
                    </Border>
                    <!-- Transient feedback only ("Copied"); empty the rest of the time, so
                         the row collapses to nothing. -->
                    <TextBlock x:Name="ChartStatusLabel" Margin="0,8,0,0" FontSize="12"
                               Foreground="#14A050" />
                </StackPanel>
            </Grid>

            <!-- Splitter -->
            <Rectangle Grid.Column="1" Fill="#E5E5E5" />

            <!-- Right panel: tabbed views. Each tab is its own workflow. -->
            <DockPanel x:Name="CanvasArea" Grid.Column="2" Background="#FFFFFF">
                <TabControl x:Name="RightTabs" Padding="0">
                    <TabItem x:Name="StrokeTab" Header="Stroke">
                        <DockPanel>
                            <ContentControl x:Name="StrokeBrushSlot" DockPanel.Dock="Top" />
                            <controls:StrokeCanvasView x:Name="StrokeView" Header="Use processed pressure data" />
                        </DockPanel>
                    </TabItem>

                    <TabItem x:Name="StrokeCompareTab" Header="Stroke compare">
                        <DockPanel>
                            <ContentControl x:Name="CompareBrushSlot" DockPanel.Dock="Top" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="1" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <controls:StrokeCanvasView Grid.Row="0" x:Name="CompareProcessedView"
                                                           Header="Use processed pressure data" />
                                <Rectangle Grid.Row="1" Fill="#CCCCCC" />
                                <controls:StrokeCanvasView Grid.Row="2" x:Name="CompareRawView"
                                                           Header="Use raw pressure data" />
                            </Grid>
                        </DockPanel>
                    </TabItem>

                <TabItem Header="Pressure response">
                    <DockPanel Margin="12">
                        <StackPanel DockPanel.Dock="Top" Spacing="8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="ResponseClearButton" Content="Clear"
                                        IsEnabled="False" Margin="6,0,0,0" Click="ResponseClear_Click" />
                                <ComboBox x:Name="ResponseDataCombo" HorizontalAlignment="Stretch"
                                          PlaceholderText="Select data..." />
                            </DockPanel>
                            <CheckBox x:Name="ResponseShowCurveEffectCheck" Content="Show effect of curve"
                                      IsChecked="True" />
                            <TextBlock x:Name="ResponseInfoLabel" Foreground="#888888" />
                        </StackPanel>
                        <controls:PressureResponseChartControl x:Name="ResponseChart" />
                    </DockPanel>
                </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
