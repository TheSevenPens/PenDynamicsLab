<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PenDynamicsLab.Controls.SectionCard">
    <Border Background="{DynamicResource Pdl.Surface}" BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="1"
            CornerRadius="8" Margin="0,0,0,8">
        <DockPanel>
            <!-- Whole header row toggles the card. Kept as a Button so it is
                 keyboard-reachable, styled flat so it reads as a header. -->
            <Button x:Name="HeaderButton" DockPanel.Dock="Top"
                    Background="Transparent" BorderThickness="0"
                    Padding="12,10" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Cursor="Hand">
                <DockPanel>
                    <TextBlock x:Name="ChevronText" DockPanel.Dock="Right" Text="&#xE70E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                               Foreground="{DynamicResource Pdl.GroupLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <!-- Title first, then state. DockPanel fills in child order, so the
                         title must be declared before the pill or the pill leads the row. -->
                    <TextBlock x:Name="TitleText" DockPanel.Dock="Left" FontWeight="SemiBold"
                               FontSize="13" Foreground="{DynamicResource Pdl.Text}" VerticalAlignment="Center" />
                    <!-- State lives in a pill, not in the title, so the name stays stable. -->
                    <Border x:Name="StatusPill" DockPanel.Dock="Left"
                            CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                            VerticalAlignment="Center" IsVisible="False">
                        <TextBlock x:Name="StatusText" FontSize="11" />
                    </Border>
                    <Panel />
                </DockPanel>
            </Button>
            <ContentPresenter x:Name="BodyPresenter" Margin="12,0,12,12" />
        </DockPanel>
    </Border>
</UserControl>
