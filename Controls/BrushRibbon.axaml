<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PenDynamicsLab.Controls.BrushRibbon">
    <!-- One 32px control band on a single baseline. Labels sit beside their control
         rather than stacked above it, which is what let the row collapse from three
         competing baselines to one; spacing replaces the old 1px separator rules. -->
    <Border Background="{DynamicResource Pdl.Surface}" BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1" Padding="16,0">
      <DockPanel Height="56">
        <!-- Clear sits at the far end, away from the settings it would undo. -->
        <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear canvas"
                Height="32" Padding="14,0" VerticalAlignment="Center"
                VerticalContentAlignment="Center" Margin="20,0,0,0" />
        <!-- ClipToBounds because this is a DockPanel's fill child: it is given whatever width
             Clear leaves, and a StackPanel that wants more than that paints straight
             over them rather than stopping. Clipping turns "too narrow" into a visibly cut-off
             row instead of controls occupying the same pixels. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10"
                    ClipToBounds="True">

            <!-- Size and opacity each say what they follow: a fixed value, or pressure. They
                 replaced one "pressure drives size or opacity" choice, which had no way to say
                 neither - and a constant-width stroke is sometimes exactly what is needed. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Size" Classes="fieldLabel" VerticalAlignment="Center" />
                <Slider x:Name="BrushSizeSlider" Width="100" Height="32" VerticalAlignment="Center"
                        Minimum="1" Maximum="200" Value="40"
                        IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock x:Name="BrushSizeLabel" Width="42" VerticalAlignment="Center" />
                <ComboBox x:Name="SizeFromCombo" Width="136" Height="32" VerticalAlignment="Center"
                          ToolTip.Tip="Whether the stroke's width follows pressure or stays at the brush size." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Opacity" Classes="fieldLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="OpacityFromCombo" Width="136" Height="32" VerticalAlignment="Center"
                          ToolTip.Tip="Whether the stroke's opacity follows pressure or stays fully opaque." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Color" Classes="fieldLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="ColorModeCombo" Width="104" Height="32" VerticalAlignment="Center" />
            </StackPanel>

        </StackPanel>
      </DockPanel>
    </Border>
</UserControl>
