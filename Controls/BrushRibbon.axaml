<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PenDynamicsLab.Controls.BrushRibbon">
    <!-- One 32px control band on a single baseline. Labels sit beside their control
         rather than stacked above it, which is what let the row collapse from three
         competing baselines to one; spacing replaces the old 1px separator rules. -->
    <Border Background="{DynamicResource Pdl.Surface}" BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1" Padding="16,0">
      <DockPanel Height="56">
        <!-- Clear sits at the far end, away from the settings it would undo. -->
        <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear canvas"
                Height="32" Padding="14,0" VerticalAlignment="Center"
                VerticalContentAlignment="Center" Margin="20,0,0,0" />
        <!-- ClipToBounds because this is a DockPanel's fill child: it is given whatever width
             Clear leaves, and a StackPanel that wants more than that paints straight over the
             button rather than stopping. Clipping turns "too narrow" into a visibly cut-off row
             instead of two controls occupying the same pixels. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14"
                    ClipToBounds="True">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Size" Classes="fieldLabel" VerticalAlignment="Center" />
                <Slider x:Name="BrushSizeSlider" Width="112" Height="32" VerticalAlignment="Center"
                        Minimum="1" Maximum="200" Value="40"
                        IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock x:Name="BrushSizeLabel" Width="42" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Color" Classes="fieldLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="ColorModeCombo" Width="108" Height="32" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Pressure drives" Classes="fieldLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="PressureControlCombo" Width="108" Height="32" VerticalAlignment="Center" />
            </StackPanel>

            <CheckBox x:Name="DrawZeroPressureCheck" Content="Draw at zero pressure"
                      Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" />

            <!-- Diagnostic mode rather than a brush setting, which is why it reports through its
                 own event instead of riding along in BrushSettings. -->
            <CheckBox x:Name="TapTestCheck" Content="Tap test"
                      ToolTip.Tip="Tap the canvas to stamp a ring of circles instead of drawing. Checks that the surface scales and rasterizes correctly, with no stroke in the way."
                      Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
</UserControl>
