<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PenDynamicsLab.Controls.BrushRibbon">
    <!-- One 32px control band on a single baseline. Labels sit beside their control
         rather than stacked above it, which is what let the row collapse from three
         competing baselines to one; spacing replaces the old 1px separator rules. -->
    <Border Background="{DynamicResource Pdl.Surface}" BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1" Padding="16,0">
      <DockPanel Height="56">
        <!-- Clear sits at the far end, away from the settings it would undo. -->
        <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Clear canvas"
                Height="32" Padding="14,0" VerticalAlignment="Center"
                VerticalContentAlignment="Center" Margin="20,0,0,0" />
        <!-- The diagnostics sit beside Clear rather than in the settings run. Neither is a brush
             setting - one changes what a pen-down means, the other writes a file - and docking
             them reserves their width, so the row clips its settings rather than silently
             dropping a diagnostic off the end. Which is exactly what happened when Tap test was
             left in the settings run and Record was added beside it. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="20,0,0,0">
            <CheckBox x:Name="TapTestCheck" Content="Tap test"
                      ToolTip.Tip="Tap the canvas to stamp a ring of circles instead of drawing. Checks that the surface scales and rasterizes correctly, with no stroke in the way."
                      Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" />
            <CheckBox x:Name="RecordCheck" Content="Record"
                      ToolTip.Tip="Capture raw pen samples to a file, for replaying this stroke later under different settings."
                      Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" />
            <TextBlock x:Name="RecordStatus" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Pdl.Muted}" />
        </StackPanel>

        <!-- ClipToBounds because this is a DockPanel's fill child: it is given whatever width
             Clear and Record leave, and a StackPanel that wants more than that paints straight
             over them rather than stopping. Clipping turns "too narrow" into a visibly cut-off
             row instead of controls occupying the same pixels. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10"
                    ClipToBounds="True">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Size" Classes="fieldLabel" VerticalAlignment="Center" />
                <Slider x:Name="BrushSizeSlider" Width="100" Height="32" VerticalAlignment="Center"
                        Minimum="1" Maximum="200" Value="40"
                        IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock x:Name="BrushSizeLabel" Width="42" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Color" Classes="fieldLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="ColorModeCombo" Width="104" Height="32" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <!-- "Pressure drives" in full, but the row cannot afford it and the combo
                     beside it says what is being driven. -->
                <TextBlock Text="Pressure" Classes="fieldLabel" VerticalAlignment="Center"
                           ToolTip.Tip="Which property of the mark pressure drives." />
                <ComboBox x:Name="PressureControlCombo" Width="104" Height="32" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Shortened from "Draw at zero pressure". The row carries three labelled
                 controls and three diagnostics; the full phrase was the first thing the clip
                 ate, and half a label is worse than a short one. -->
            <CheckBox x:Name="DrawZeroPressureCheck" Content="Draw at zero"
                      ToolTip.Tip="Keep marking while the pen reports no pressure, instead of ending the stroke."
                      Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" />

        </StackPanel>
      </DockPanel>
    </Border>
</UserControl>
