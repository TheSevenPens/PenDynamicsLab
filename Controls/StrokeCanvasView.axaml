<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kit="clr-namespace:StrokeKit.Avalonia;assembly=StrokeKit.Avalonia"
             x:Class="PenDynamicsLab.Controls.StrokeCanvasView">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel Height="40">
                <!-- State as a quiet pill rather than a bold caption bar. -->
                <Border x:Name="HeaderPill" Background="{DynamicResource Pdl.ActiveFill}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="HeaderDot" Width="6" Height="6" Fill="{DynamicResource Pdl.Accent}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderText" FontSize="12" Foreground="{DynamicResource Pdl.SubtleText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <Border x:Name="ImageHost" Background="{DynamicResource Pdl.CanvasPaper}" ClipToBounds="True">
            <!-- Export and clear live on the canvas's own right-click menu, matching the
                 curve chart. Nothing competes with the drawing surface for chrome. -->
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy to clipboard" Click="Copy_Click" />
                    <MenuItem Header="Save as PNG..." Click="Save_Click" />
                    <Separator />
                    <MenuItem Header="Clear canvas" Click="Clear_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <!-- StrokeKit's view. It owns the bitmap it presents into, sized to its own
                 viewport rather than to the surface, so an oversized surface is clipped by
                 the view instead of by this border, and two views can show one surface at
                 different sizes. That is what the Stroke tab and the Compare tab are.

                 DragPans is off and the view stays at 1:1: this is a bench showing a stroke
                 at its true size, not a document to navigate. -->
            <kit:SurfaceView x:Name="CanvasSurface" DragPans="False" />
        </Border>
    </DockPanel>
</UserControl>
