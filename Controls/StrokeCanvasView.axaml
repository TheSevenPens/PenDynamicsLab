<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PenDynamicsLab.Controls.StrokeCanvasView">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Pdl.Surface}"
                BorderBrush="{DynamicResource Pdl.Divider}" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel Height="40">
                <!-- State as a quiet pill rather than a bold caption bar. -->
                <Border x:Name="HeaderPill" Background="{DynamicResource Pdl.ActiveFill}" CornerRadius="4" Padding="8,3"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="HeaderDot" Width="6" Height="6" Fill="{DynamicResource Pdl.Accent}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderText" FontSize="12" Foreground="{DynamicResource Pdl.SubtleText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <Border x:Name="ImageHost" Background="{DynamicResource Pdl.CanvasPaper}" ClipToBounds="True">
            <!-- Export and clear live on the canvas's own right-click menu, matching the
                 curve chart. Nothing competes with the drawing surface for chrome. -->
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy to clipboard" Click="Copy_Click" />
                    <MenuItem Header="Save as PNG..." Click="Save_Click" />
                    <Separator />
                    <MenuItem Header="Clear canvas" Click="Clear_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <!-- Canvas pins the Image at (0, 0) regardless of how Avalonia's layout would
                 otherwise handle an oversized bitmap (e.g., when the shared processed bitmap
                 is larger than this host because it was sized in a different tab).

                 Stretch=Fill with an explicit Width/Height, both assigned by DrawSurface in
                 DIPs, is what maps the high-resolution backing store onto the screen 1:1.
                 Stretch=None would lay the bitmap out one pixel per DIP, which the compositor
                 then magnifies by the render scaling — strokes land RenderScaling times too
                 far from the origin. Because the DIP size always equals pixel size / scale,
                 "Fill" is an identity transform here, not a resample. -->
            <Canvas>
                <Image x:Name="CanvasImage" Stretch="Fill" Canvas.Left="0" Canvas.Top="0" />
            </Canvas>
        </Border>
    </DockPanel>
</UserControl>
