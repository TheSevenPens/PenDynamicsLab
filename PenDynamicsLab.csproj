<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PenDynamicsLab</RootNamespace>
    <AssemblyName>PenDynamicsLab</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Nothing under vendor/ belongs to this application.

    The project file sits at the repository root, so every default glob the SDK and Avalonia
    add reaches into the submodules beneath it. StrokeKit brings WinPenKit nested inside
    itself, and WinPenKit ships sample applications: without these removes the build tries to
    compile a WinUI app and to resolve the XAML of an Avalonia one as part of this program.
  -->
  <ItemGroup>
    <Compile Remove="vendor\**" />
    <AvaloniaResource Remove="vendor\**" />
    <AvaloniaXaml Remove="vendor\**" />
    <EmbeddedResource Remove="vendor\**" />
    <None Remove="vendor\**" />
    <Page Remove="vendor\**" />
    <ApplicationDefinition Remove="vendor\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      vendor\** because the project file sits at the repository root, so this glob reaches
      into every submodule beneath it. StrokeKit brings WinPenKit nested inside itself, and
      without this the build tries to compile WinPenKit's WinUI and WPF samples as part of
      this application.
    -->
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**;PenDynamicsLab.Tests\**;vendor\**" />
    <EmbeddedResource Include="Persistence\SampleResponses\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- DrawSurface.CopyRows is the strided blit, pulled out of CopyToAvBitmap so the
         padded-stride path can be tested without a real framebuffer. It is an
         implementation detail, so it stays internal rather than joining the public API
         just to be reachable from the test project. -->
    <InternalsVisibleTo Include="PenDynamicsLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia.Win32 + Avalonia.Skia rather than the Avalonia.Desktop metapackage, which
         also pulls the X11, FreeDesktop and macOS backends this Windows-only app can never
         load. Avalonia.Win32 does not depend on Avalonia.Skia, so both are named. -->
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Win32" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <!-- Avalonia 12 split text shaping out of Skia. UsePlatformDetect registers HarfBuzz;
         naming backends does not, and the app throws "No text shaping system configured"
         on startup without it. -->
    <PackageReference Include="Avalonia.HarfBuzz" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      WinPenKit is not referenced directly any more. StrokeKit references it and it arrives
      transitively, both halves, at the commit StrokeKit pins.

      Referencing it directly as well put two different checkouts of the same assembly in one
      build graph: the sibling ..\WinPenKit and the one nested inside StrokeKit. Both were
      compiled and one won the race to be copied, which is a thing to find out about now
      rather than from a type identity error later.
    -->
    <ProjectReference Include="vendor\StrokeKit\src\StrokeKit\StrokeKit.csproj" />
    <ProjectReference Include="vendor\StrokeKit\src\StrokeKit.Avalonia\StrokeKit.Avalonia.csproj" />
  </ItemGroup>

  <!-- Linked, not copied: this is the yardstick both repos are measured by, and two
       copies of a yardstick is one too many. -->
  <ItemGroup>
    <Content Include="..\WinPenKit\testdata\reference-stroke.csv"
             Link="testdata\reference-stroke.csv"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
