<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PenDynamicsLab</RootNamespace>
    <AssemblyName>PenDynamicsLab</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**;PenDynamicsLab.Tests\**" />
    <EmbeddedResource Include="Persistence\SampleResponses\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- DrawSurface.CopyRows is the strided blit, pulled out of CopyToAvBitmap so the
         padded-stride path can be tested without a real framebuffer. It is an
         implementation detail, so it stays internal rather than joining the public API
         just to be reachable from the test project. -->
    <InternalsVisibleTo Include="PenDynamicsLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinPenKit\WinPenKit\WinPenKit.csproj" />
    <ProjectReference Include="..\WinPenKit\WinPenKit.Avalonia\WinPenKit.Avalonia.csproj" />
  </ItemGroup>

</Project>
